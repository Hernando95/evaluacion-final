<div class="auth-container">
  <h1>Iniciar Sesión</h1>
  <form action="/api/sessions/login" method="POST" class="auth-form">
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" required placeholder="adminCoder@coder.com" />
    </div>
    <div class="form-group">
      <label>Contraseña</label>
      <input type="password" name="password" required placeholder="adminCod3r123" />
    </div>
    <button type="submit" class="btn btn-primary">Entrar</button>
  </form>
  <p>¿No tenés cuenta? <a href="/register">Registrate acá</a></p>
</div>

<style>
.auth-container { max-width: 400px; margin: 4rem auto; padding: 2rem; background: #fff; border-radius: 12px; box-shadow: 0 4px 20px rgba(0,0,0,0.1); text-align: center; }
.auth-form { display: flex; flex-direction: column; gap: 1.2rem; margin: 1.5rem 0; }
.form-group { text-align: left; display: flex; flex-direction: column; gap: 0.4rem; }
.form-group input { padding: 0.8rem; border: 1px solid #ddd; border-radius: 6px; }
</style>
